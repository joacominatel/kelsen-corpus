{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joacominatel/kelsen-corpus/schema/kelsen.schema.json",
  "title": "kelsen-corpus store settings, spec 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "account", "host", "spec", "protection"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "account": { "type": "string", "minLength": 1 },
    "host": { "type": "string", "minLength": 1 },
    "spec": { "const": 1 },
    "protection": { "enum": ["ruleset", "none"] },
    "license": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" }
  }
}
