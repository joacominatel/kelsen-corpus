{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joacominatel/kelsen-corpus/schema/entry.schema.json",
  "title": "kelsen-corpus entry frontmatter, spec 2",
  "x-rule": "KC-E02",
  "type": "object",
  "additionalProperties": false,
  "required": ["permalink", "title", "type", "status", "claim", "provenance", "context", "evidence", "lifecycle"],
  "properties": {
    "permalink": { "x-rule": "KC-F-PERMALINK", "$ref": "#/$defs/permalink" },
    "title": { "x-rule": "KC-F-TITLE", "type": "string", "minLength": 8, "maxLength": 120 },
    "type": { "x-rule": "KC-F-TYPE", "const": "knowledge" },
    "status": { "x-rule": "KC-F-STATUS", "enum": ["verified", "stale", "superseded", "retracted"] },
    "claim": {
      "x-rule": "KC-F-CLAIM",
      "type": "string",
      "maxLength": 280,
      "pattern": "^(?!.*[.!?]\\s)[^\\r\\n]*\\S[^\\r\\n]*$"
    },
    "tags": {
      "x-rule": "KC-F-TAGS",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\S+$" }
    },
    "provenance": {
      "x-rule": "KC-F-PROVENANCE",
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "sources", "author", "recorded_on"],
      "properties": {
        "project": { "$ref": "#/$defs/line" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/changeRef" }
        },
        "author": { "$ref": "#/$defs/login" },
        "recorded_on": { "$ref": "#/$defs/date" }
      }
    },
    "context": {
      "x-rule": "KC-F-CONTEXT",
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "dependencies"],
      "properties": {
        "language": { "$ref": "#/$defs/versioned" },
        "runtime": { "$ref": "#/$defs/versioned" },
        "platform": { "$ref": "#/$defs/line" },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ecosystem", "name", "version"],
            "properties": {
              "ecosystem": { "enum": ["npm", "pypi", "go", "cargo", "maven", "nuget", "gem", "other"] },
              "name": { "$ref": "#/$defs/line" },
              "version": { "$ref": "#/$defs/version" }
            }
          }
        }
      }
    },
    "evidence": {
      "x-rule": "KC-F-EVIDENCE",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "shows"],
        "properties": {
          "kind": { "enum": ["test", "run", "pr", "commit", "issue", "doc"] },
          "ref": { "type": "string" },
          "shows": { "$ref": "#/$defs/line", "maxLength": 200 }
        },
        "if": { "properties": { "kind": { "const": "doc" } }, "required": ["kind"] },
        "then": { "properties": { "ref": { "$ref": "#/$defs/docRef" } } },
        "else": { "properties": { "ref": { "$ref": "#/$defs/immutableRef" } } }
      }
    },
    "lifecycle": {
      "x-rule": "KC-F-LIFECYCLE",
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_on", "review_by"],
      "properties": {
        "verified_on": { "$ref": "#/$defs/date" },
        "review_by": { "$ref": "#/$defs/date" },
        "superseded_by": { "$ref": "#/$defs/permalink" },
        "supersedes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/permalink" }
        },
        "retracted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "ref"],
          "properties": {
            "reason": { "$ref": "#/$defs/line" },
            "ref": { "$ref": "#/$defs/immutableRef" }
          }
        }
      }
    },
    "stats": {
      "x-rule": "KC-F-STATS",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "as_of", "source"],
        "properties": {
          "name": { "$ref": "#/$defs/line", "not": { "const": "citations" } },
          "value": { "type": "number" },
          "unit": { "$ref": "#/$defs/line" },
          "as_of": { "$ref": "#/$defs/date" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["report", "measurement", "job"] },
              "ref": { "$ref": "#/$defs/immutableRef" },
              "reporter": { "$ref": "#/$defs/line" }
            },
            "if": { "properties": { "kind": { "const": "report" } }, "required": ["kind"] },
            "then": { "required": ["reporter"] },
            "else": { "required": ["ref"] }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "x-rule": "KC-F-LIFECYCLE",
      "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
      "then": { "properties": { "lifecycle": { "required": ["superseded_by"] } } },
      "else": { "properties": { "lifecycle": { "not": { "required": ["superseded_by"] } } } }
    },
    {
      "x-rule": "KC-F-LIFECYCLE",
      "if": { "properties": { "status": { "const": "retracted" } }, "required": ["status"] },
      "then": { "properties": { "lifecycle": { "required": ["retracted"] } } },
      "else": { "properties": { "lifecycle": { "not": { "required": ["retracted"] } } } }
    }
  ],
  "$defs": {
    "line": {
      "type": "string",
      "pattern": "^\\S[^\\r\\n]*$"
    },
    "permalink": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
    },
    "date": {
      "x-rule": "KC-F-DATE",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "version": {
      "x-rule": "KC-F-VER",
      "type": "string",
      "pattern": "^(?=\\S)(?![xX](\\.|$))(?!.*\\.[xX](\\.|$))[^\\^~<>*\\r\\n]+$"
    },
    "versioned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/line" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "changeRef": {
      "x-rule": "KC-F-REF",
      "type": "string",
      "pattern": "^https://<host>/[A-Za-z0-9-]+/[A-Za-z0-9._-]+/(pull/[0-9]+|commit/[0-9a-f]{40})$"
    },
    "immutableRef": {
      "x-rule": "KC-F-REF",
      "type": "string",
      "pattern": "^https://<host>/[A-Za-z0-9-]+/[A-Za-z0-9._-]+/(commit/[0-9a-f]{40}|(blob|tree)/[0-9a-f]{40}(/[^\\s#?]*)?|pull/[0-9]+|issues/[0-9]+|actions/runs/[0-9]+)(#\\S*)?$"
    },
    "docRef": {
      "x-rule": "KC-F-REF",
      "anyOf": [
        { "$ref": "#/$defs/immutableRef" },
        {
          "type": "string",
          "pattern": "^https://(?!(www\\.)?<host>(/|$))[^/\\s]+(/\\S*)?$"
        }
      ]
    }
  }
}
