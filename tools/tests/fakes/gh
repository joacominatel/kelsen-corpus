#!/usr/bin/env bash
# Fake GitHub: answers only the calls corpus.sh makes, logs each with the token it ran under,
# and keeps its state under $FAKE. Remotes are bare repositories in $FAKE/remotes.
set -euo pipefail
printf 'GH_TOKEN=%s %s\n' "${GH_TOKEN:-}" "$*" >> "$FAKE/gh.log"

filter=; args=()
while [ $# -gt 0 ]; do
  case $1 in --jq) filter=$2; shift 2 ;; *) args+=("$1"); shift ;; esac
done
set -- "${args[@]}"
out() { if [ -n "$filter" ]; then jq -r "$filter"; else cat; fi; }
unexpected() { echo "fake gh: unexpected call: $*" >&2; exit 99; }
opt() { local want=$1; shift; while [ $# -gt 1 ]; do [ "$1" = "$want" ] && { echo "$2"; return; }; shift; done; }

case "$1 $2" in
  "auth token")
    user=$(opt --user "$@")
    [ ! -e "$FAKE/logged-out/$user" ] || { echo "no oauth token found for $user" >&2; exit 1; }
    echo "token-$user" ;;
  "repo create")
    repo=$3; remote="$FAKE/remotes/$repo.git"
    [ "$(opt --template "$@")" = joacominatel/kelsen-corpus ] || unexpected "$@"
    case " $* " in *" --private "*) echo true ;; *" --public "*) echo false ;; *) unexpected "$@" ;; esac > "$FAKE/private"
    git init -q --bare -b main "$remote"
    seed="$FAKE/seed"; mkdir -p "$seed"
    # A store hosting these tests is not the template: leave its entries and settings behind.
    (cd "$FAKE_TEMPLATE" && git ls-files -z -- . ':!entries' ':!kelsen.yml' | xargs -0 tar -cf -) | tar -xf - -C "$seed"
    mkdir -p "$seed/entries"; touch "$seed/entries/.gitkeep"
    printf 'id: example\naccount: example-bot\nhost: github.com\nspec: 1\nprotection: none\n' > "$seed/kelsen.yml"
    git -C "$seed" init -q -b main
    git -C "$seed" add -f .
    git -C "$seed" commit -q -m "Initial commit"
    git -C "$seed" push -q "$remote" main
    rm -rf "$seed" ;;
  "repo view")
    printf '{"isPrivate":%s}\n' "$(cat "$FAKE/private")" | out ;;
  "pr list")
    head=$(opt --head "$@")
    if [ -e "$FAKE/pr-${head//\//-}" ]; then printf '[{"url":"%s"}]\n' "$(cat "$FAKE/pr-${head//\//-}")"; else echo '[]'; fi | out ;;
  "pr create")
    head=$(opt --head "$@")
    url="https://github.com/$(opt -R "$@")/pull/7"
    echo "$url" > "$FAKE/pr-${head//\//-}"
    echo "$url" ;;
  "pr merge")
    if [ -e "$FAKE/auto-merge-refuses" ]; then
      echo "GraphQL: Protected branch rules not configured for this branch (enablePullRequestAutoMerge)" >&2
      exit 1
    fi ;;
  api\ *)
    shift; method=GET
    [ "$1" = -X ] && { method=$2; shift 2; }
    path=$1
    case "$method $path" in
      "GET user") printf '{"login":"%s"}\n' "$(cat "$FAKE/active")" | out ;;
      "GET users/"*)
        [ -e "$FAKE/accounts/${path#users/}" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
        echo '{}' ;;
      "GET user/repository_invitations")
        user=${GH_TOKEN#token-}
        if [ -e "$FAKE/invitations/$user" ]; then
          jq -n --arg repo "$(cat "$FAKE/invitations/$user")" '[{id: 99, repository: {full_name: $repo}}]'
        else echo '[]'; fi | out ;;
      "PATCH user/repository_invitations/99")
        user=${GH_TOKEN#token-}
        [ -e "$FAKE/invitations/$user" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
        mv "$FAKE/invitations/$user" "$FAKE/collaborators/$user" ;;
      "GET repos/"*/collaborators/*)
        [ -e "$FAKE/collaborators/${path##*/}" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; } ;;
      "GET repos/"*/rules/branches/main)
        [ -e "$FAKE/ruleset.json" ] || { echo '[]' | out; exit 0; }
        jq '.id as $id | [.rules[] | . + {ruleset_source_type: "Repository", ruleset_id: $id}]' "$FAKE/ruleset.json" | out ;;
      "GET repos/"*/branches/main) echo '{}' ;;
      "POST repos/"*/rulesets)
        if [ -e "$FAKE/plan-refuses" ]; then
          echo "gh: Upgrade to GitHub Pro or make this repository public to enable this feature. (HTTP 403)" >&2
          exit 1
        fi
        jq '. + {id: 42}' > "$FAKE/ruleset.json"
        out < "$FAKE/ruleset.json" ;;
      "GET repos/"*/rulesets/42)
        if [ -e "$FAKE/readback-differs" ]; then
          jq '.bypass_actors = [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}]' "$FAKE/ruleset.json"
        elif [ -e "$FAKE/readback-drops-tools" ]; then
          jq '(.rules[] | select(.type == "required_status_checks").parameters.required_status_checks) |= map(select(.context != "tools"))' "$FAKE/ruleset.json"
        else
          cat "$FAKE/ruleset.json"
        fi | out ;;
      "PUT repos/"*/rulesets/42)
        if [ -e "$FAKE/ruleset-update-ignored" ]; then cat > /dev/null; else jq '. + {id: 42}' > "$FAKE/ruleset.json"; fi
        out < "$FAKE/ruleset.json" ;;
      "PUT repos/"*/collaborators/*)
        user=${path##*/}; repo=${path#repos/}; repo=${repo%/collaborators/*}
        [ -e "$FAKE/collaborators/$user" ] || echo "$repo" > "$FAKE/invitations/$user"
        echo '{}' ;;
      "PATCH repos/"*)
        [ "$*" = "repos/${path#repos/} -F allow_auto_merge=true" ] || unexpected api "$method" "$@"
        [ -e "$FAKE/auto-merge-ignored" ] || touch "$FAKE/auto-merge" ;;
      "GET repos/"*)
        [[ $path =~ ^repos/[^/]+/[^/]+$ ]] || unexpected api "$method" "$path"
        [ -d "$FAKE/remotes/${path#repos/}.git" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
        printf '{"allow_auto_merge":%s}\n' "$([ -e "$FAKE/auto-merge" ] && echo true || echo false)" | out ;;
      *) unexpected api "$method" "$path" ;;
    esac ;;
  *) unexpected "$@" ;;
esac
